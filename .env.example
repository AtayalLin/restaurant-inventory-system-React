# 複製這個檔案為 .env 再填入實際值（.env 已在 .gitignore，不會被提交）

# ── 只在開發伺服器端使用（沒有 VITE_ 前綴，不會被打包進前端）──
# NVIDIA NIM API 金鑰：由 vite.config.ts 的 proxy 在伺服器端加到請求標頭
NVIDIA_API_KEY=nvapi-請填入你的金鑰
# 後端位置：/api 會被轉發到這裡（換成 Spring Boot 時改這個值）
API_PROXY_TARGET=http://localhost:3001

# ── 前端可見（VITE_ 前綴會被打包，只能放公開資訊，不能放金鑰）──
VITE_API_BASE_URL=/api
VITE_N8N_RESTOCK_URL=http://localhost:5678/webhook/test-lin
VITE_N8N_QUERY_URL=http://localhost:5678/webhook/query-assistant
# AI 模型名稱（模型名稱不是機密，可以放 VITE_）
# 注意：n8n workflow 的 HTTP Request 節點也要同步更換
VITE_AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
